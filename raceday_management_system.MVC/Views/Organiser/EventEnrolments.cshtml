@model List<raceday_management_system.MVC.Models.enrolment_view_model>
@{
    ViewData["Title"] = "Event Enrolments";
    int eventId = ViewBag.EventId;
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3>Enrolments for Event #@eventId</h3>
        <a asp-action="Dashboard" class="btn btn-secondary">Back to Dashboard</a>
    </div>

    <div class="card shadow">
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Enrolment ID</th>
                        <th>Participant ID</th>
                        <th>Date</th>
                        <th>Status</th>
                        <th>Payment</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Enrolment_id</td>
                                <td>@item.Participant_id</td>
                                <td>@item.Enrolment_date.ToString("dd MMM yyyy")</td>
                                <td><span class="badge bg-success">@item.Enr_status</span></td>
                                <td>@item.Payment_status</td>
                                <td>
                                    <a asp-action="RecordResult" asp-route-enrolmentId="@item.Enrolment_id" asp-route-eventId="@eventId" class="btn btn-sm btn-primary">Record Result</a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="6" class="text-center text-muted py-3">No enrolments yet.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>