@model raceday_management_system.MVC.Models.profile_view_model
@{ ViewData["Title"] = "My Profile"; }

<div class="container mt-4">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    <div class="row">
        <!-- Picture Section -->
        <div class="col-md-4 text-center">
            <div class="card shadow mb-4 border-0">
                <div class="card-body p-4">
                    <img src="@(string.IsNullOrEmpty(Model.Profile_picture_url) ? "/images/default-profile.png" : Model.Profile_picture_url)" 
                         class="rounded-circle img-fluid mb-3 shadow" 
                         alt="Profile Picture"
                         style="width: 150px; height: 150px; object-fit: cover; border: 3px solid #e0e0e0;" />
                         
                    <h4 class="fw-bold">@Model.Firstname @Model.Surname</h4>
                    <p class="text-muted mb-4">@Model.Email</p>

                    <!-- ONLY show upload button if the user is a Participant -->
                    @if (Context.Session.GetString("Role") == "Participant")
                    {
                        <form asp-controller="profile" asp-action="UploadPicture" method="post" enctype="multipart/form-data">
                            <!-- Hidden native file input -->
                            <input type="file" name="file" id="profilePicUpload" required accept="image/*"
                                   style="display: none;" onchange="this.form.submit();" />
                                   
                            <!-- Custom Blue Button that triggers the hidden input -->
                            <label for="profilePicUpload" class="btn btn-primary w-100 py-2 fw-bold">
                                Upload Profile
                            </label>
                        </form>
                    }
                </div>
            </div>
        </div>

        <!-- Profile Edit Section (Remains the same) -->
        <div class="col-md-8">
            <div class="card shadow border-0">
                <div class="card-header bg-dark text-white rounded-top-4 py-3">
                    <h5 class="mb-0 fw-bold">Edit Profile</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-controller="profile" asp-action="Update" method="post">
                        <div class="row mb-3">
                            <div class="col">
                                <label class="form-label fw-semibold">First Name</label>
                                <input name="firstname" value="@Model.Firstname" class="form-control" required />
                            </div>
                            <div class="col">
                                <label class="form-label fw-semibold">Surname</label>
                                <input name="surname" value="@Model.Surname" class="form-control" required />
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Phone Number</label>
                            <input name="phoneNumber" value="@Model.Phone_number" class="form-control" />
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-semibold">Date of Birth</label>
                            <input name="dateOfBirth" type="date" value="@Model.Date_of_birth?.ToString("yyyy-MM-dd")" class="form-control" />
                        </div>
                        <button type="submit" class="btn btn-success w-100 py-2 fw-bold fs-5">Save Changes</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>