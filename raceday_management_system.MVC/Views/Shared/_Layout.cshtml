<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RaceDay</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/raceday_management_system.MVC.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <!-- Brand Logo -->
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <div class="logo-container">
                        <img src="~/images/logo.png" alt="RaceDay Logo" />
                    </div>
                    RaceDay
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">

                    <!-- Left Side Navigation -->
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>

                        <!-- Navigation links based on Role -->
                        @if (Context.Session.GetString("Role") == "Organiser")
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Organiser" asp-action="Dashboard">Dashboard</a>
                            </li>
                        }
                        else if (Context.Session.GetString("Role") == "Participant")
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Participant" asp-action="MyEvents">My Events</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Participant" asp-action="MyResults">My Results</a>
                            </li>
                        }
                    </ul>

                    <!-- Right Side Navigation (Auth / Session) -->
                    <ul class="navbar-nav align-items-center">
                        @if (Context.Session.GetString("User_id") != null)
                        {
                            <!-- User is logged in -->
                            <li class="nav-item me-3">
                                <!-- Profile Picture linking to Profile page -->
                                <a asp-controller="profile" asp-action="Index" class="nav-link p-0" title="My Profile">
                                    <img src="@(Context.Session.GetString("ProfilePicture") ?? "/images/default-profile.png")"
                                         alt="Profile"
                                         class="rounded-circle shadow-sm"
                                         style="width: 40px; height: 40px; object-fit: cover;" />
                                </a>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Auth" asp-action="Logout" method="post" class="form-inline m-0">
                                    <button type="submit" class="btn btn-link nav-link text-danger fw-bold text-decoration-none p-0">Logout</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <!-- User is logged out -->
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Auth" asp-action="Login">Login</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Auth" asp-action="Register">Register</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted mt-5">
        <div class="container">
            &copy; 2026 - RaceDay - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>