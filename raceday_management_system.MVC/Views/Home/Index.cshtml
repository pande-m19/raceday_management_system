@model List<raceday_management_system.MVC.Models.event_card_view_model>
@{
    ViewData["Title"] = "Upcoming Events";
}

<div class="container mt-4">
    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold text-primary">Upcoming Events</h1>
        <p class="lead text-muted">Find your next race, walk, or cycle in South Africa.</p>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center py-4 shadow-sm">
            <h4>No upcoming events found.</h4>
            @if (Context.Session.GetString("User_id") == null)
            {
                <p class="mb-0"><a asp-controller="Auth" asp-action="Login">Log in</a> to see upcoming events.</p>
            }
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var ev in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0">
                        <!-- Display Azure Image -->
                        @if (!string.IsNullOrEmpty(ev.Banner_image_url))
                        {
                            <img src="@ev.Banner_image_url" class="card-img-top" alt="@ev.Event_name" style="height: 200px; object-fit: cover;">
                        }
                        else
                        {
                            <div class="bg-secondary text-white d-flex justify-content-center align-items-center" style="height: 200px;">
                                <span>No Image Available</span>
                            </div>
                        }

                        <div class="card-body">
                            <span class="badge bg-primary mb-2">@ev.Event_type</span>
                            <h5 class="card-title fw-bold">@ev.Event_name</h5>
                            <p class="card-text text-muted mb-1">
                                📅 @ev.Event_date.ToString("dd MMM yyyy")
                            </p>
                            <p class="card-text text-muted mb-3">
                                📍 @ev.Location
                            </p>
                            <div class="d-flex justify-content-between align-items-center">
                                <h6 class="mb-0 fw-bold text-success">R @ev.Entry_fee.ToString("0.00")</h6>
                                <!-- Points to the events controller which we will build next -->
                                <a asp-controller="events" asp-action="Details" asp-route-id="@ev.Event_id" class="btn btn-outline-primary">View Details</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>