@model List<raceday_management_system.MVC.Models.event_card_view_model>
@{
    ViewData["Title"] = "Upcoming Events";
}

<!-- Hero Banner (Blue gradient restored) -->
<div class="hero-section text-white text-center d-flex align-items-center justify-content-center"
     style="background: linear-gradient(rgba(13, 110, 253, 0.8), rgba(13, 110, 253, 0.8)), url('/images/hero-bg.jpeg') no-repeat center center; background-size: cover; height: 450px; margin-top: -24px; margin-bottom: 50px;">
    <div class="container">
        <h1 class="display-3 fw-bold mb-3" style="text-shadow: 2px 2px 4px rgba(0,0,0,0.5);">Find Your Next Challenge</h1>
        <p class="lead fs-4 mb-4 fw-semibold" style="text-shadow: 1px 1px 3px rgba(0,0,0,0.5);">Join thousands of runners, walkers, and cyclists across South Africa.</p>

        @if (Context.Session.GetString("User_id") == null)
        {
            <a asp-controller="Auth" asp-action="Register" class="btn btn-primary btn-lg px-5 py-3 rounded-pill fw-bold shadow-lg">Join RaceDay Today</a>
        }
        else
        {
            <a href="#upcoming-events" class="btn btn-primary btn-lg px-5 py-3 rounded-pill fw-bold shadow-lg">Browse Events</a>
        }
    </div>
</div>

<!-- Events Grid -->
<div class="container mt-4" id="upcoming-events">
    <div class="text-center mb-5">
        <h2 class="display-5 fw-bold text-primary">Upcoming Events</h2>
        <p class="lead text-muted">Find your next race, walk, or cycle in South Africa.</p>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center py-5 shadow-sm border-0 rounded-4">
            <h4 class="fw-bold">No upcoming events found.</h4>
            @if (Context.Session.GetString("User_id") == null)
            {
                <p class="mb-0">Please <a asp-controller="Auth" asp-action="Login" class="fw-bold text-decoration-none">Log in</a> to see upcoming events.</p>
            }
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 mb-5">
            @foreach (var ev in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0 rounded-4">
                        <!-- Display Azure Image -->
                        @if (!string.IsNullOrEmpty(ev.Banner_image_url))
                        {
                            <img src="@ev.Banner_image_url" class="card-img-top" alt="@ev.Event_name" style="height: 200px; object-fit: cover; border-radius: 16px 16px 0 0;">
                        }
                        else
                        {
                            <div class="bg-secondary text-white d-flex justify-content-center align-items-center" style="height: 200px; border-radius: 16px 16px 0 0;">
                                <span>No Image Available</span>
                            </div>
                        }

                        <div class="card-body p-4">
                            <span class="badge bg-primary mb-2 px-3 py-2">@ev.Event_type</span>
                            <h5 class="card-title fw-bold text-dark mb-3">@ev.Event_name</h5>
                            
                            <p class="card-text text-muted mb-2">
                                <i class="bi bi-calendar-event me-2"></i> @ev.Event_date.ToString("dd MMM yyyy")
                            </p>
                            <p class="card-text text-muted mb-4">
                                <i class="bi bi-geo-alt-fill me-2"></i> @ev.Location
                            </p>

                            <div class="d-flex justify-content-between align-items-center mt-auto">
                                <h5 class="mb-0 fw-bold text-success">R @ev.Entry_fee.ToString("0.00")</h5>
                                <a asp-controller="events" asp-action="Details" asp-route-id="@ev.Event_id" class="btn btn-outline-primary px-4 rounded-pill fw-bold">View Details</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>