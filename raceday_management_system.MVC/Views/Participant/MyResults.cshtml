@model List<raceday_management_system.MVC.Models.my_result_view_model>
@{
    ViewData["Title"] = "My Results";
}

<div class="container mt-4">
    <h2 class="mb-4">My Race Results</h2>
    <div class="card shadow">
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Event</th>
                        <th>Date</th>
                        <th>Finish Time</th>
                        <th>Overall Position</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-bold">@item.Event_name</td>
                                <td>@item.Event_date.ToString("dd MMM yyyy")</td>
                                <td>@item.Finish_time</td>
                                <td>
                                    <span class="badge bg-primary fs-6">@item.PositionContext</span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="4" class="text-center py-4 text-muted">No results recorded yet.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>