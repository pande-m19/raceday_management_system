@model List<raceday_management_system.MVC.Models.event_card_view_model>
@{
    ViewData["Title"] = "All Events";
}

<div class="container mt-4">
    <div class="text-center mb-5">
        <h1 class="display-5 fw-bold text-primary">All Events</h1>
        <p class="lead text-muted">Browse the complete history of events in the system.</p>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center py-4 shadow-sm rounded-4">
            <h4 class="fw-bold">No events found in the system.</h4>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 mb-5">
            @foreach (var ev in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0 rounded-4">
                        <!-- Display Azure Image with Fallback -->
                        @if (!string.IsNullOrEmpty(ev.Banner_image_url))
                        {
                            <img src="@ev.Banner_image_url" class="card-img-top" alt="@ev.Event_name" 
                                 style="height: 200px; object-fit: cover; border-radius: 16px 16px 0 0;"
                                 onerror="this.onerror=null; this.src='https://placehold.co/600x400?text=No+Image';">
                        }
                        else
                        {
                            <div class="bg-secondary text-white d-flex justify-content-center align-items-center" style="height: 200px; border-radius: 16px 16px 0 0;">
                                <span>No Image Available</span>
                            </div>
                        }

                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <span class="badge bg-primary px-3 py-2 rounded-pill">@ev.Event_type</span>
                            </div>
                            
                            <h5 class="card-title fw-bold text-dark mb-3">@ev.Event_name</h5>
                            
                            <p class="card-text text-muted mb-2">
                                <i class="bi bi-calendar-event me-2"></i> @ev.Event_date.ToString("dd MMM yyyy")
                            </p>
                            <p class="card-text text-muted mb-4">
                                <i class="bi bi-geo-alt-fill me-2"></i> @ev.Location
                            </p>
                            
                            <div class="d-flex justify-content-between align-items-center mt-auto">
                                <h5 class="mb-0 fw-bold text-success">R @ev.Entry_fee.ToString("0.00")</h5>
                                <a asp-controller="events" asp-action="Details" asp-route-id="@ev.Event_id" class="btn btn-outline-primary px-4 rounded-pill fw-bold">View Details</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>